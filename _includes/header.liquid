<header class="profile-sidebar">
  <div class="sidebar-inner">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <a class="profile-photo" href="{{ '/' | relative_url }}" aria-label="Xiaoyu Ou — About">
      <img src="{{ '/assets/img/Xiaoyu-Ou.jpg' | relative_url }}" alt="Xiaoyu Ou" width="6000" height="4000" loading="eager" decoding="sync" fetchpriority="high">
    </a>
    <a class="sidebar-name" href="{{ '/' | relative_url }}">{{ site.first_name }} <strong>{{ site.last_name }}</strong></a>
    <p class="intro-role">PhD Candidate in Electrical and Electronic Engineering</p>
    <p class="intro-affiliation"><a class="academic-link" href="https://www.bristol.ac.uk/" target="_blank" rel="noopener noreferrer">University of Bristol</a><span>United Kingdom</span></p>
    <div class="intro-links">
      <a href="mailto:{{ site.data.socials.email }}"><i class="ti ti-mail" aria-hidden="true"></i><span>Email me</span></a>
      <a href="https://orcid.org/{{ site.data.socials.orcid_id }}" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-orcid" aria-hidden="true"></i><span>ORCID</span></a>
      <a href="{{ site.data.socials.work_url }}" target="_blank" rel="noopener noreferrer"><i class="ti ti-school" aria-hidden="true"></i><span>Research profile</span></a>
      <a href="{{ site.data.socials.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer"><i class="ti ti-file-cv" aria-hidden="true"></i><span>CV</span></a>
    </div>
    <nav id="navbar" aria-label="Main navigation">
      <span class="nav-highlight" aria-hidden="true"></span>
      <ul class="navbar-nav">
        <li class="nav-item {% if page.permalink == '/' %}active{% endif %}"><a class="nav-link" href="{{ '/' | relative_url }}" {% if page.permalink == '/' %}aria-current="page"{% endif %}>About</a></li>
        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null %}
            <li class="nav-item {% if page.url == p.url %}active{% endif %}"><a class="nav-link" href="{{ p.url | relative_url }}" {% if page.url == p.url %}aria-current="page"{% endif %}>{{ p.title }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>
