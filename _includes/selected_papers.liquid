<div class="publications publication-list publication-cards selected-publications">
  {% bibliography --group_by none --template publication_card --query @*[selected=true]* %}
</div>
<dialog id="publication-figure-dialog" class="publication-figure-dialog" aria-labelledby="publication-figure-heading" aria-describedby="publication-figure-caption">
  <div class="publication-figure-toolbar"><h2 id="publication-figure-heading">Paper figure</h2><button type="button" class="publication-figure-close" aria-label="Close figure"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
  <img class="publication-figure-image" alt="">
  <p id="publication-figure-caption"></p>
</dialog>
