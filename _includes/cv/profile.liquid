<div class="cv-profile module-hover" id="Profile">
  {% for item in profile.contents %}
    {% if item.name == 'Name' %}<p class="cv-profile-name">{{ item.value }}</p>{% endif %}
    {% if item.name == 'Position' %}<p class="cv-profile-role">{{ item.value }}</p>{% endif %}
  {% endfor %}
  <div class="cv-profile-meta">
    {% for item in profile.contents %}
      {% if item.name == 'Institution' or item.name == 'Email' %}<span>{{ item.value }}</span>{% endif %}
    {% endfor %}
  </div>
</div>
