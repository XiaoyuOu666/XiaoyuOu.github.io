<header class="post-header">
  <div class="cv-page-heading">
    <h1 class="post-title">{{ page.display_title | default: page.title }}</h1>
    {% if page.cv_pdf %}
    <a class="section-link cv-download"
      {% if page.cv_pdf contains '://' %}
      href="{{ page.cv_pdf }}" target="_blank" rel="noopener noreferrer"
      {% else %}
      href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" download="Xiaoyu-Ou-CV.pdf"
      {% endif %}
      aria-label="Download Xiaoyu Ou's CV (PDF)">
      <span class="section-link-label">Download CV</span>
      <span class="section-link-icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" focusable="false"><path d="M8 2.5v8M4.75 7.25 8 10.5l3.25-3.25M3 11v2h10v-2" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    </a>
    {% endif %}
  </div>
  {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
</header>
