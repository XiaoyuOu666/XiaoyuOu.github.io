<ul class="cv-timeline">
  {% for content in entry.contents %}
    <li class="cv-timeline-entry">
      <div class="cv-entry-date">{{ content.year }}{% if content.location %}<span class="cv-entry-location">{{ content.location }}</span>{% endif %}</div>
      <div class="cv-entry-content">
        {% if content.title %}<h3 class="cv-entry-title">{{ content.title }}</h3>{% endif %}
        {% if content.institution %}<p class="cv-entry-institution">{{ content.institution }}</p>{% endif %}
        {% if content.department %}<p class="cv-entry-institution">{{ content.department }}</p>{% endif %}
        {% if content.maindescription %}<p>{{ content.maindescription }}</p>{% endif %}
        {% assign detail_keys = 'description,items' | split: ',' %}
        {% for detail_key in detail_keys %}
          {% if content[detail_key] %}
            <ul class="cv-entry-details">
              {% for item in content[detail_key] %}
                <li>{% if item.contents %}{{ item.title }}<ul>{% for subitem in item.contents %}<li>{{ subitem }}</li>{% endfor %}</ul>{% else %}{{ item }}{% endif %}</li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endfor %}
        {% if content.linkitems %}
          <div class="container-links">
            {% for item in content.linkitems %}
              {% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener noreferrer" class="btncv z-depth-0">{{ item.linkname | default: 'doc' }}</a>{% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
