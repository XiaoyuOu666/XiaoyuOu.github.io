---
layout: default
---
  <div class="post cv-page">
    {% include cv/header.liquid %}

    <article>
      <div class="cv">
        {% for entry in site.data.cv %}
          <section class="cv-section module-hover" id="{{ entry.title }}" aria-labelledby="cv-heading-{{ forloop.index }}">
            <div class="cv-section-heading">
              <h2 class="cv-section-title" id="cv-heading-{{ forloop.index }}">{{ entry.title }}</h2>
            </div>
            <div>
              {% if entry.title == 'Honors and Awards' %}
                {% include cv/awards.liquid %}
              {% elsif entry.title == 'Academic Service' %}
                {% include cv/service.liquid %}
              {% elsif entry.title == 'Teaching Experience' %}
                {% include cv/teaching.liquid %}
              {% elsif entry.type == 'nested_list' %}
                {% include cv/nested_list.liquid %}
              {% elsif entry.type == 'skill_groups' %}
                {% include cv/skills.liquid %}
              {% elsif entry.type == 'time_table' %}
                {% include cv/time_table.liquid %}
              {% else %}
                {{ entry.contents }}
              {% endif %}
            </div>
          </section>
        {% endfor %}
      </div>
    </article>
  </div>
